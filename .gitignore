# Dependencies
node_modules/

# Build output
dist/
# The production extension bundle. `dist/` above does not match it.
dist-prod/
.next/
# Per-instance Next build dirs (scripts/dev.mjs)
.next-*/
.turbo/

# Electron compiled output (source is electron/*.ts; compiled JS is generated)
electron/main.js
electron/preload.js
electron/*.js.map

# Electron-builder release artifacts
release/

# Generated desktop icons (source of truth is build/icon.png)
build/icon.icns
build/icon.ico
build/icons/

# Tauri build output (source is src-tauri/; target/ and gen/ are generated)
src-tauri/target/
src-tauri/gen/
# macOS-style global gitignores often contain `Icon?`, which also matches
# the src-tauri/icons/ directory — re-include the Tauri icon set explicitly.
!src-tauri/icons/

# Capacitor-generated native projects (created by `cap add ios|android`).
#
# ios/ is COMMITTED. Every hand-edit a shipping app needs — the bundle
# identifier, the display name, the ATS exception that lets a plaintext
# localhost dev API through, the orientation set, entitlements — lives in that
# tree and `cap add` does not write any of it (it is a bare template
# extraction). .github/workflows/mobile-release.yml also assumes the tree
# exists in a fresh checkout while never running `cap add`.
#
# Generated-but-tracked inside it: ios/App/CapApp-SPM/Package.swift is rewritten
# by every `cap sync`, so a diff there after a build is normal. Commit it when
# the plugin set changed.
#
# android/ is still generated — un-ignore it when the Android stage lands.
android/

# Next.js static export output.
# out/        — web build (`pnpm build:client`), Playwright, and the
#               Electron/Tauri shells (`pnpm build:desktop`).
# out-mobile/ — the Capacitor bundle only (`pnpm build:mobile`), kept separate
#               so a test build can never be synced into the app.
packages/client/out/
packages/client/out-mobile/

# Environment (committed: .env.example, .env.development, AND
#              .env.production — because production values are
#              encrypted via dotenvx, not plaintext).
#
# .env.keys must NEVER be committed — it contains the private keys
# that decrypt the encrypted values in .env.production.
.env
.env.local
.env.keys
.env.*.local

# IDE
.vscode/
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Testing
test-results/
playwright-report/
coverage/

# Docker
.docker-data/

# TypeScript
*.tsbuildinfo

# Docusaurus
docs-site/.docusaurus/
docs-site/build/

# Misc
*.log
npm-debug.log*

# The extension's toolbar icons. macOS-oriented global ignores commonly carry
# an `Icon?` rule for the Finder's `Icon\r` artifact, and on a case-insensitive
# match that also swallows `icons/` — silently shipping an extension with no
# toolbar icon. Git will not descend into an ignored directory, so the
# directory itself has to be un-ignored before its contents can be.
!packages/extension/public/icons/
!packages/extension/public/icons/**

# Self-host configuration for docker-compose.selfhost.yml.
#
#   cp .env.selfhost.example .env
#   # edit the two values under REQUIRED
#   docker compose -f docker-compose.selfhost.yml up -d
#
# Plain text, all of it. There is no key to fetch, no secrets manager to set
# up and no encrypted env file: the published server image contains no .env
# file, so every value below is read as an ordinary environment variable.
#
# Compose reads `.env` from this directory automatically, which is why the
# copy above is named `.env` rather than `.env.selfhost`. To keep a different
# filename, pass it: `docker compose --env-file .env.selfhost -f
# docker-compose.selfhost.yml up -d`.


# ══ REQUIRED ═══════════════════════════════════════════════════════════════

# The domain the app is served on, without a scheme. Point an A (and AAAA)
# record at this machine first: Caddy asks Let's Encrypt for a certificate on
# the first request, and that challenge is answered over ports 80 and 443,
# which must be reachable from the internet.
#
# The app must live at the ROOT of the domain. A subpath such as
# example.com/tracktime breaks the live-sync WebSocket, whose URL is derived
# from the browser's origin and would still resolve to example.com/ws.
APP_DOMAIN=track.example.com

# A random secret that signs sessions. Generate one, keep it: changing it
# signs every device out.
#
#   openssl rand -base64 32
#
# Do not deploy the placeholder.
BETTER_AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32


# ══ VERSION ════════════════════════════════════════════════════════════════

# Which release to run. Both images are tagged together, so one value covers
# the server and the web app.
#
# Pinned on purpose — an unattended `docker compose pull` should never move
# you onto a release you have not read the notes for. `latest` also exists if
# you would rather track the newest stable release; `:main` is the owner's
# own deploy tag and is not a release, so do not point this at it.
TRACKTIME_VERSION=v0.1.0


# ══ OPTIONAL: the full URL ═════════════════════════════════════════════════

# Defaults to https://${APP_DOMAIN}, which is what you want for any real
# deployment. Set it only when the origin is not that — a plain-HTTP trial or
# a non-standard port, e.g. APP_DOMAIN=localhost with:
#
#   APP_URL=http://localhost
#
# It must match what people actually type in the browser, character for
# character. In production the origin check is a literal string comparison, so
# http://localhost and http://127.0.0.1 are two different deployments as far
# as the session cookie and the WebSocket upgrade are concerned — pick one
# spelling and use it everywhere.
#APP_URL=https://track.example.com


# ══ OPTIONAL: email ════════════════════════════════════════════════════════
#
# Any SMTP relay works — a mailbox provider, a transactional service, or an
# unauthenticated relay on your own network (leave SMTP_USER and SMTP_PASSWORD
# empty and no AUTH is attempted).
#
# Leave SMTP_HOST empty and no mail is sent at all. Nothing breaks: sign-up
# needs no verification, and a password-reset request prints its reset link to
# the server log instead of mailing it —
#
#   docker compose -f docker-compose.selfhost.yml logs server | grep 'reset'
#
# — which is how you get back in if you lock yourself out of a single-user
# instance. Worth setting up before you invite anyone else.

#SMTP_HOST=smtp.example.com
# 587 (STARTTLS) is the default. 465 is implicit TLS, 25 is unencrypted.
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
# Implicit TLS from the first byte. Unset it follows the port, which is right
# for every provider worth using; set true/false only for an odd relay.
#SMTP_SECURE=
# The From address. Most relays only accept a domain they are configured to
# send for, so there is no sensible default to guess.
#EMAIL_FROM=tracktime@example.com


# ══ OPTIONAL: extra sign-in origins ════════════════════════════════════════
#
# Comma-separated origins allowed to sign in, on top of your own. Empty is
# correct for a browser-only self-host. Needed only if you build one of the
# other clients for your instance:
#
#   chrome-extension://<id>   the browser extension (pnpm run extension:id)
#   capacitor://localhost     the mobile shell
#
# The Raycast extension and any CLI need nothing here — they send no Origin
# header at all and are guarded by the device-approval flow instead.
#TRUSTED_ORIGINS=


# ══ OPTIONAL: external databases ═══════════════════════════════════════════
#
# Set either of these to use a managed database instead of the container in
# the compose file, then drop that service and its depends_on entry.
#
# Redis is wired up but nothing reads it yet: sessions live in MongoDB and
# live sync fans out in-process. Leaving the line below commented out does not
# switch it off — the compose file defaults REDIS_URL to the bundled container
# — so running without Redis means editing docker-compose.selfhost.yml: delete
# the `redis` service, the `depends_on` entry that waits for it, and the
# REDIS_URL line. The server then logs one line saying it skipped the
# connection, and the app is unaffected.
#MONGODB_URI=mongodb://mongo:27017/tracktime
#REDIS_URL=redis://redis:6379


# ══ OPTIONAL: everything else ══════════════════════════════════════════════
#
# All of this is off when empty, and the app is feature-complete that way —
# tracking, the catalog, tags, reports, invoices, import and export do not
# touch any of it. Nothing phones home: with the analytics variables unset at
# image build time the web app emits no third-party script tags at all.

# Error reporting. Any Sentry-protocol endpoint works, including a
# self-hosted GlitchTip.
#SENTRY_DSN=

# "Sign in with Google". Email and password is always available; with these
# empty no social provider is registered and no button is rendered.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Subscription billing. Only meaningful if you are charging other people to
# use your instance; with STRIPE_MODE empty the subscription card is not
# rendered at all.
#STRIPE_MODE=
#STRIPE_SECRET_KEY=
#STRIPE_PUBLISHABLE_KEY=
#STRIPE_WEBHOOK_SECRET=

# Newsletter (Listmonk). Marketing-site scaffolding from the starter this app
# was generated from; the time tracker's UI never calls it. Leaving the
# LISTMONK_* variables unset leaves those two endpoints inert.

# Object storage (S3_* / AWS_*). Deliberately absent: nothing in the server
# reads it. Invoice and report PDFs are rendered and returned inline, and CSV
# and JSON exports are built in memory, so there is no bucket to provision.

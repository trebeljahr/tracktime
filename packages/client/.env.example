PORT=6477
# API ORIGIN, not a base path — the client appends /api/trpc and /api/auth
# itself, and the server mounts those AT /api, so requests land on
# https://api.trackyourtime.dev/api/trpc. The API is a separate host from the
# web app, so the server needs this origin in FRONTEND_URL / TRUSTED_ORIGINS.
NEXT_PUBLIC_API_URL=https://api.trackyourtime.dev

# WebSocket origin. The /api/ws path is appended by resolveSyncUrl.
NEXT_PUBLIC_WS_URL=wss://api.trackyourtime.dev

# OpenPanel analytics (optional)
# NEXT_PUBLIC_OPENPANEL_CLIENT_ID=your-client-id

# Plausible analytics (optional)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Sentry/GlitchTip (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://key@glitchtip.example.com/2

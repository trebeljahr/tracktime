# Client image for the SELF-HOST stack (docker-compose.selfhost.yml).
#
# Separate from packages/client/Dockerfile, which packages the owner's Coolify
# deploy and is not touched by any of this. Two things differ, and both are
# load-bearing:
#
#   1. NEXT_PUBLIC_API_URL is built EMPTY. Next inlines NEXT_PUBLIC_* into the
#      browser bundle at build time, so an image built against a URL is
#      permanently bound to that host. Empty makes every call site fall back to
#      a relative URL — /api/trpc, window.location.origin for better-auth,
#      wss://<host>/ws for the sync socket — so ONE image works behind
#      anybody's domain, given the single-domain proxy in ./Caddyfile.
#
#   2. It ships the STATIC EXPORT. next.config.ts sets `output: "export"`
#      unconditionally, so `next build` emits packages/client/out/ and never
#      a .next/standalone directory or a server.js to run. There is no Node
#      process in the runtime stage at all.
#
# Caddy serves it rather than nginx: the same server binary already fronts the
# stack (one config syntax to learn instead of two), `try_files` plus directory
# indexes are a three-line config, and it runs as an unprivileged user given
# nothing but two writable directories — where nginx's stock image wants
# /var/cache/nginx, /var/run and a rewritten config before it will start as
# non-root.

# ── Stage 1: Install dependencies ────────────────────────────────────
FROM node:24-bookworm-slim AS deps
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/server/package.json packages/server/
COPY packages/client/package.json packages/client/
# Install all workspace deps (this stage is discarded — only out/ survives).
RUN pnpm install --frozen-lockfile

# ── Stage 2: Build the static export ─────────────────────────────────
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/core packages/core
# packages/server is source-only input: packages/client/tsconfig.json maps
# `@starter/server/trpc` to ../server/src/trpc/router.ts for the AppRouter
# type. Nothing from it is built or shipped.
COPY packages/server packages/server
COPY packages/client packages/client

# Declared with an empty default so a plain `docker compose build` produces the
# portable same-origin bundle without anyone having to remember the flag.
# Passing a value here re-binds the image to that origin — only useful if you
# deliberately split the API onto its own host.
#
# NEXT_PUBLIC_WS_URL is deliberately absent: it is read nowhere in the source,
# and offering the knob would send anyone debugging a WebSocket problem down a
# dead end. The socket URL is derived from NEXT_PUBLIC_API_URL.
#
# The analytics vars are absent for a different reason: unset, the app emits no
# third-party script tags at all, so a self-hosted instance makes no outbound
# request from the browser that its operator did not ask for.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Same order as the root `build:client` script — @starter/core is a real
# runtime dependency of the client and resolves through its dist/, so it has
# to be compiled before Next resolves the import.
RUN pnpm --filter @starter/shared run build \
 && pnpm --filter @starter/core run build \
 && pnpm --filter @starter/client run build

# ── Stage 3: Static runtime ──────────────────────────────────────────
FROM caddy:2.11-alpine AS runtime

# Restated from the base image, because the chown below is what makes them
# usable: Caddy autosaves its adapted config under XDG_CONFIG_HOME and keeps
# certificate state under XDG_DATA_HOME, and it refuses to start when it
# cannot write them — which is exactly what a bare `USER app` would produce.
ENV XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data

RUN addgroup -S app && adduser -S -G app app \
 && mkdir -p /config /data \
 && chown -R app:app /config /data

# trailingSlash: true means every route is a DIRECTORY holding an index.html,
# so the file server needs three things beyond a plain root:
#   - {path} first, so /_next/static/... and a directory both hit disk;
#     file_server then answers a directory request without the trailing slash
#     with a canonical redirect that keeps the query string (the password
#     reset link arrives as /reset-password?token=...).
#   - {path}/index.html, so /track/ resolves to out/track/index.html.
#   - /404.html last, the export's own not-found page. It is served with a
#     200 rather than a 404 — a soft not-found, the usual trade for a static
#     export, and nothing in the app depends on the status.
# The hashed build output under /_next/static is content-addressed, so it can
# be cached forever; nothing else here may be, or a deploy would leave stale
# HTML pointing at chunks that no longer exist.
RUN printf '%s\n' \
  ':8080 {' \
  '	root * /srv' \
  '	encode zstd gzip' \
  '	@immutable path /_next/static/*' \
  '	header @immutable Cache-Control "public, max-age=31536000, immutable"' \
  '	try_files {path} {path}/index.html /404.html' \
  '	file_server' \
  '}' > /etc/caddy/Caddyfile

COPY --from=build --chown=app:app /app/packages/client/out /srv

USER app
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:8080/ || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base config targets Node (module NodeNext, emitting declarations).
    // Vite bundles this package instead, so resolution is bundler-style and
    // nothing is emitted — tsc is only ever run as a type checker here.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}

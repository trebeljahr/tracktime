# tracktime server environment.
#
# Copy to .env.development for local work. A container deployment does not
# need a file at all: the server reads plain process environment variables,
# and only loads a .env file when one happens to sit next to the built app.
# Everything below is a plain value — nothing here requires encrypted-env
# tooling or a private key.
#
# Only three variables have to be set — APP_URL, MONGODB_URI and
# BETTER_AUTH_SECRET. PORT sits with them for proximity but has a default.
# Every other section is optional and its feature stays switched off while its
# variables are empty; none of them is on a boot path.


# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Where the app is reachable, exactly as typed in the browser — scheme, host,
# and port if it is not the default. One value for the whole deployment when
# the web app and this API share a domain (a reverse proxy sends /api and /ws
# here, everything else to the static client): it supplies both FRONTEND_URL
# and BETTER_AUTH_URL below.
#
# It is the site's base origin, NOT the auth mount — better-auth appends its
# own /api/auth path. No trailing path, no trailing slash.
#
# The spelling matters: http://localhost:5159 and http://127.0.0.1:5159 are
# different origins to a browser and different sites for cookies, so pick one
# and use it everywhere. Use https for anything reachable off your machine —
# session cookies are only marked Secure when the URL says https.
APP_URL=https://tracktime.example.com

# Split deployments — the web app on one host, this API on another — set these
# two instead, and they win over APP_URL wherever both are present. With
# APP_URL set you can leave both empty.
#   FRONTEND_URL     origin of the web app; first entry of the trusted-origin
#                    list used for CORS and better-auth's origin check
#   BETTER_AUTH_URL  this API's own origin, the base better-auth builds its
#                    routes and email links on
# FRONTEND_URL=https://tracktime.example.com
# BETTER_AUTH_URL=https://api.tracktime.example.com

# MongoDB connection string. In a compose file this is the service name, e.g.
#   mongodb://mongo:27017/tracktime
MONGODB_URI=mongodb://127.0.0.1:27017/tracktime-dev

# Signing key for sessions. Generate a fresh one — `openssl rand -base64 32` —
# and keep it stable: changing it signs everybody out.
BETTER_AUTH_SECRET=change-me-in-production-use-a-random-32-char-string

# Port this server listens on. Optional, defaults to 5000; the published
# image sets 5159.
PORT=5159


# ─── EMAIL (optional) ────────────────────────────────────────────────────────

# Without any of this, mail is not sent: password-reset and invitation links
# are written to the server log instead ("[auth] Password reset URL for ..."),
# so a locked-out admin can still recover with `docker logs`. Fine for a
# single-user instance; set SMTP up before inviting anyone else.

# SMTP is the default transport and is selected as soon as SMTP_HOST is set —
# ahead of Listmonk below, even if that is also configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                       # 587 STARTTLS (default), 465 implicit TLS, 25 relay
# SMTP_USER=                          # omit both user and password for an
# SMTP_PASSWORD=                      # unauthenticated relay on a private network
# SMTP_SECURE=                        # true | false; unset follows the port (465 → true)
# EMAIL_FROM=tracktime@example.com    # required with SMTP; most relays only
#                                     # accept a domain they are set up to send for

# Listmonk + SES — the transactional path used by the hosted deploy, and an
# alternative to SMTP rather than an addition. Selected only when the whole
# set is present. `hatchkit add <project> listmonk-ses` fills these in: it
# publishes the SES identity to DNS and creates the lists and templates.
# LISTMONK_URL=https://listmonk.example.com
# LISTMONK_API_USER=hatchkit
# LISTMONK_API_TOKEN=...
# LISTMONK_FROM_EMAIL=noreply@mail.yourdomain.com
# LISTMONK_FROM=Your Project <noreply@mail.yourdomain.com>
# LISTMONK_LIVE_LIST_ID=1
# LISTMONK_TEST_LIST_ID=2
# LISTMONK_TX_TEMPLATE_ID=1
# LISTMONK_CAMPAIGN_TEMPLATE_ID=2
# LISTMONK_TEST_RECIPIENT=you@example.com   # default target for newsletter:test-tx / welcome / verify


# ─── ADDITIONAL ORIGINS (optional) ───────────────────────────────────────────

# Extra origins trusted for CORS and auth, comma-separated. FRONTEND_URL (or
# APP_URL) is always trusted; this is only for clients that are not the web
# app. A browser-only deployment needs nothing here.
#   Capacitor iOS+Android: capacitor://localhost,https://localhost
#   Custom Electron proto: app://-
#   Browser extension:     chrome-extension://<id>
# Electron file:// sends Origin: null and can't be trusted with credentials;
# register a custom protocol in electron/main.ts and add it here instead. The
# extension's id comes from `pnpm run extension:id`; without its origin here,
# better-auth answers sign-in with 403 INVALID_ORIGIN, because a real browser
# fetch carries Sec-Fetch-* headers and those force origin validation.
# TRUSTED_ORIGINS=capacitor://localhost,https://localhost,app://-

# Google sign-in. Both must be set, or no social provider is registered at
# all. Email and password sign-in works regardless.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# ─── OPTIONAL EXTRAS ─────────────────────────────────────────────────────────

# Error reporting. Any Sentry-protocol endpoint works, including a self-hosted
# GlitchTip. Unset means nothing is reported anywhere.
# SENTRY_DSN=https://key@glitchtip.example.com/1

# Redis. Nothing in the time tracker reads it — sessions live in MongoDB and
# realtime sync fans out in-process — so leave it unset. That in-process
# fan-out is also why the server must run as a SINGLE replica: a second one
# would deliver sync events only to the devices connected to the same process.
# REDIS_URL=redis://127.0.0.1:6379

# Payments. The subscription UI is hidden entirely while STRIPE_MODE is empty,
# which is the right state for a self-hosted instance.
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# S3-compatible storage. Not used by the time tracker — invoices, reports and
# exports are generated in memory and returned through the API — these belong
# to the starter's asset pipeline. Do not stand up a bucket for this.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET_NAME=tracktime-dev
# S3_PUBLIC_URL=http://127.0.0.1:9000/tracktime-dev
# S3_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
